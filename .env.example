# jev(TypeSafe) 관문. 키가 있으면 장르·유형 판정과 의미 위험 1차 판정을 jev 가 맡는다.
# 키가 없으면 이 파일이 없어도 되고, 파이프라인은 지금까지와 똑같이 돈다.
# 이 파일을 .env 로 복사하고 키를 넣는다. .env 는 커밋되지 않는다.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# 0 이면 키가 있어도 jev 를 쓰지 않는다. 외부로 내보낼 수 없는 문서에 쓴다.
ANTI_WORKSLOP_JEV=1

# 관문별로 끈다. GATE=입력 판정(원문 앞 8,000자를 보낸다),
# SEMANTIC=의미 위험 1차 판정(원문·결과의 문장 쌍을 보낸다).
ANTI_WORKSLOP_JEV_GATE=1
ANTI_WORKSLOP_JEV_SEMANTIC=1
